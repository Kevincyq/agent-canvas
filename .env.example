# Turing OpenAI-compatible proxy (preferred for this PoC)
TURING_API_BASE=https://live-turing.cn.llm.tcljd.com/api/v1
TURING_API_KEY=
TURING_MODEL=turing/gpt-5.5

# Cloud ASR via Azure Speech Services (realtime + batch).
AZURE_STT_KEY=
AZURE_STT_REGION=eastasia
ASR_LANGUAGE_CODE=zh

MCP_SERVER_URL=https://mcp.fluxink.ai/servers/d706699b03524ba6aa84423954c43f3f/mcp
MCP_SERVER_NAME=FluxInk TCL MCP
MCP_AUTH_TOKEN=
MCP_TIMEOUT_MS=60000

FLUXINK_HWR_UI_RESOURCE_URI=ui://fluxink/fluxink-hwr-canvas.html

# Portal origin allowed to embed this app in iframe (CSP frame-ancestors).
PORTAL_FRAME_ANCESTOR_ORIGIN=https://ai.eaglelab.tcl.com https://ai.tcl.com

# Staging deploy secrets are injected by GitLab CI (see docs/DEPLOYMENT.md).
# Do not commit .env.staging or real keys.
