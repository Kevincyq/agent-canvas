# Turing OpenAI-compatible proxy (preferred for this PoC)
TURING_API_BASE=https://live-turing.cn.llm.tcljd.com/api/v1
TURING_API_KEY=
TURING_MODEL=turing/gpt-5.5

# Real Web Search (server-only). No mock fallback is used.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_MAX_RESULTS=5

# Agent runtime budgets (server-only safety limits).
AGENT_MAX_TURNS=8
AGENT_RUN_TIMEOUT_MS=90000
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_CALLS_PER_TOOL=4
AGENT_MAX_TOOL_CONCURRENCY=3
AGENT_TOOL_TIMEOUT_MS=20000

# Cloud ASR via Azure Speech Services. Browser realtime only; the server issues a short-lived STS token.
AZURE_STT_KEY=
AZURE_STT_REGION=eastasia
ASR_LANGUAGE_CODE=zh

MCP_SERVER_URL=https://mcp.fluxink.ai/servers/d706699b03524ba6aa84423954c43f3f/mcp
MCP_SERVER_NAME=FluxInk TCL MCP
MCP_AUTH_TOKEN=
MCP_TIMEOUT_MS=120000

FLUXINK_HWR_UI_RESOURCE_URI=ui://fluxink/fluxink-hwr-canvas.html

# Portal origin allowed to embed this app in iframe (CSP frame-ancestors).
PORTAL_FRAME_ANCESTOR_ORIGIN=https://ai.eaglelab.tcl.com https://ai.tcl.com

# Staging deploy uploads this file as the server .env via deploy/scripts/local-deploy.sh.
# Do not commit .env.local or real keys. See docs/DEPLOYMENT.md.

# Optional: SQLite path for Conversation/Session persistence (default ./data/agent-canvas.sqlite)
# SQLITE_PATH=./data/agent-canvas.sqlite

# Optional: force Agents SDK API mode for spikes/runtime.
# OPENAI_API=chat_completions

# Portal user context placeholder headers (set by Portal/gateway in production):
#   X-Portal-User-Id
#   X-Portal-Tenant-Id
